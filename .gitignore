# Source-update locks are runtime coordination artifacts, not repository state.
# https://github.com/FlareZ123/pokemon-sims/issues/1492
/src/*.lock
/src/**/*.lock

# Local compiler, Python, and diagnostic outputs are generated state.
# These patterns keep CI evidence in artifacts and source-bound reports.
# Pattern syntax: https://git-scm.com/docs/gitignore
/build/
**/__pycache__/
*.py[cod]
/issue-*-seed-*.txt
